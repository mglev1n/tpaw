{
  "name": "@tpaw/plancraft",
  "version": "0.1.0",
  "description": "Scenario layer for TPAW Planner: compile LLM-friendly scenario JSON to PlanParams, simulate, and compare.",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "plancraft": "dist/Cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf ./dist && rm -f tsconfig.tsbuildinfo",
    "test": "jest",
    "test:watch": "jest --watch",
    "gen-wire": "rm -rf ./src/Engine/Wire && mkdir ./src/Engine/Wire && protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/Engine/Wire --ts_proto_opt=oneof=unions --ts_proto_opt=esModuleInterop=true --proto_path=../simulator-rust/src/lib/wire ../simulator-rust/src/lib/wire/*.proto",
    "gen-schema": "node dist/Schema/GenJsonSchema.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@tpaw/common": "file:../common",
    "commander": "^13.1.0",
    "fast-json-patch": "^3.1.1",
    "lodash": "^4.17.21",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.196",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-proto": "^2.6.1",
    "typescript": "^5.7.3"
  }
}
