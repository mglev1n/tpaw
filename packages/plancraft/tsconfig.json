{
  "include": ["./src/**/*"],

  "compilerOptions": {
    // Type checking.
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    // Off to keep the files copied verbatim from packages/web (which does not
    // set it) compiling unchanged. See src/Engine/UpstreamDrift.test.ts.
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "forceConsistentCasingInFileNames": true,

    // Output controls.
    "outDir": "./dist",
    "target": "es2019",
    "module": "commonjs",
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "incremental": true,

    // Input controls.
    "rootDir": "./src",

    "lib": ["es2019", "DOM", "ESNext"],
    "esModuleInterop": true
  }
}
